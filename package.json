{
  "name": "x-player-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop X-Player. Opens any video file and starts playing in under a second.",
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -b",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "node e2e/run.mjs",
    "ffmpeg": "node scripts/stage-ffmpeg.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "preflight": "node scripts/preflight.mjs",
    "release": "npm run preflight && npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "x-player": "github:UtkukaanSCK/X-Player"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Utku Kaan"
}
